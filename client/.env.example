# Optional API origin. Leave unset in same-origin production deployments.
VITE_API_URL=/api

# Optional analytics. GA4 is loaded only when a valid G- measurement ID is set.
# Do not put names, email addresses, phone numbers, form messages or CV details in events.
VITE_GA_MEASUREMENT_ID=

# Optional ownership-verification tokens supplied by Google Search Console and Bing Webmaster Tools.
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
